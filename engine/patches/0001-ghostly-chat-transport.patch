diff --git a/engine/Makefile b/engine/Makefile
index ab4281d..d23a9a0 100644
--- a/engine/Makefile
+++ b/engine/Makefile
@@ -1895,6 +1895,9 @@ ifeq ($(FTE_TARGET),web)
 	EMCC_LDFLAGS+= -s ALLOW_MEMORY_GROWTH=1			#reduce crashes...
 	EMCC_LDFLAGS+= -s MAX_WEBGL_VERSION=2			#make use of what we can.
 	EMCC_LDFLAGS+= -s TOTAL_STACK=5MB			#big!
+	EMCC_LDFLAGS+= -s DYNAMIC_EXECUTION=0		#ghostly: the runner's CSP has no 'unsafe-eval'.
+	EMCC_LDFLAGS+= -s ENVIRONMENT=web			#ghostly: a page, never node or a worker.
+	EMCC_LDFLAGS+= -s EXPORTED_FUNCTIONS=_main,_malloc,_free	#ghostly: the page types console commands (FTEC.cbufadd).
    	EMCC_LDFLAGS+=-s ERROR_ON_UNDEFINED_SYMBOLS=1	#fairly obvious. no runtime errors please.
 	RELEASE_CFLAGS=-DOMIT_QCC -DGL_STATIC $(EMCC_CFLAGS)
 	DEBUG_CFLAGS=-gsource-map -DOMIT_QCC -DGL_STATIC $(EMCC_CFLAGS)
diff --git a/engine/common/net_wins.c b/engine/common/net_wins.c
index 3af47a0..a632645 100644
--- a/engine/common/net_wins.c
+++ b/engine/common/net_wins.c
@@ -9278,8 +9278,14 @@ static ftenet_generic_connection_t *FTENET_WebSocket_EstablishConnection(ftenet_
 
 	if (isserver)
 	{
-		Con_Printf("Browsers are unable to host regular servers. Please use an rtc://broker:port/serverid scheme instead.\n");
-		datasocket = INVALID_SOCKET;
+		//ghostly: the page carries one peer's packets over its chat, so a listen server can take that one client.
+		if (!strncmp(adr.address.websocketurl, "ws://ghostly.invalid/", 21))
+			datasocket = emscriptenfte_ws_connect(adr.address.websocketurl, "ghostly-host");
+		else
+		{
+			Con_Printf("Browsers are unable to host regular servers. Please use an rtc://broker:port/serverid scheme instead.\n");
+			datasocket = INVALID_SOCKET;
+		}
 	}
 	else
 		datasocket = emscriptenfte_ws_connect(adr.address.websocketurl, "fteqw");
diff --git a/engine/web/ftejslib.js b/engine/web/ftejslib.js
index bc04299..a769677 100644
--- a/engine/web/ftejslib.js
+++ b/engine/web/ftejslib.js
@@ -189,7 +189,8 @@ mergeInto(LibraryManager.library,
 				case 'mousemove':
 					if (FTEC.evcb.mouse != 0)
